{
  "description": "Inject the thinking codex into every session as additional context (KODEX_LANG=cs|en, default en)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/kodex-${KODEX_LANG:-en}.md\"; [ -f \"$f\" ] || f=\"${CLAUDE_PLUGIN_ROOT}/kodex-en.md\"; cat \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
